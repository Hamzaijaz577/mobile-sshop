# Copy this file to .env for local development and fill in real values.

# MongoDB Atlas connection string (from Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://admin:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mobile_store

# Admin dashboard login key
ADMIN_KEY=admin123

# Set this once the frontend is deployed, e.g. https://mobile-store.vercel.app
FRONTEND_URL=
